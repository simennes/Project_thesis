library(dplyr)
dataset <- read.table("https://www.math.ntnu.no/emner/TMA4315/2018h/jsp2.txt",
header = TRUE)
ggpairs(data = dataset, mapping = aes(col = gender), columns = c("social","raven", "math"), legend = 1)
dataset$social <- factor(dataset$social,
levels = 1:4,
labels = c("S1", "S2", "S3", "S4"))
levels(dataset$social)
model_lm <- lm(math ~ raven + gender, data = dataset)
summary(model_lm)
fitRI1 <- lmer(math ~ raven + gender + (1 | school), data = dataset)
summary(fitRI1)
coef.fitRI1 <- summary(fitRI1)$coefficients
raven.estimate <- coef.fitRI1["raven", "Estimate"]
raven_se <- coef.fitRI1["raven", "Std. Error"]
# Wald and Z-score test
Wald <- (raven.estimate / raven_se)^2
Z.score <- sqrt(Wald)
p.val.Wald <- 1 - pchisq(Wald, df = 1)
p.val.Z <- 2 * (1 - pnorm(abs(Z.score)))
cat("Wald statistic:", Wald, "\n")
cat("Z-score:", Z.score, "\n")
cat("p-value (Wald):", p.val.Wald, "\n")
cat("p-value (Z-test):", p.val.Z, "\n")
gender_se <- coef.fitRI1["gendergirl", "Std. Error"]
gender_estimate <- coef.fitRI1["gendergirl", "Estimate"]
CI_gender <- c(gender_estimate - 1.96 * gender_se,
gender_estimate + 1.96 * gender_se)
cat("95% confidence interval for gender (female):", CI_gender, "\n")
fitRI3 = lmer(math ~ raven + social + (1 | school), data = dataset)
